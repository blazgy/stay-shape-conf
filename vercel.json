{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/share.js": { "includeFiles": "index.html" },
    "api/share-image.js": {
      "includeFiles": "assets/{fonts/**,sh-hero4.avif,part-sarajevo.avif}",
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/gallery",
      "destination": "/gallery.html"
    },
    {
      "source": "/share",
      "destination": "/api/share"
    },
    {
      "source": "/planner",
      "destination": "https://stay-shape-conference-planner.blazgyoha.workers.dev/planner"
    },
    {
      "source": "/planner/",
      "destination": "https://stay-shape-conference-planner.blazgyoha.workers.dev/planner/"
    },
    {
      "source": "/planner/:path*",
      "destination": "https://stay-shape-conference-planner.blazgyoha.workers.dev/planner/:path*"
    }
  ],
  "redirects": [
    { "source": "/gallery/", "destination": "/gallery", "permanent": true }
  ]
}
